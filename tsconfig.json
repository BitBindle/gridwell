{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": true,
        "strictNullChecks": false,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["dom", "dom.iterable", "es2022"],
        "types": [],
        "skipLibCheck": true
    },
    "include": ["src/**/*.js", "src/**/*.d.ts"],
    "exclude": ["src/test.js", "src/webcomponent.js"]
}
