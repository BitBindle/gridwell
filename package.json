{
    "name": "@bitbindle/gridwell",
    "title": "Gridwell",
    "description": "An accessible JavaScript data grid with spreadsheet controls, with no dependencies. A fork of Jspreadsheet CE.",
    "repository": {
        "type": "git",
        "url": "https://github.com/BitBindle/jspreadsheet-ce.git"
    },
    "author": {
        "name": "BitBindle"
    },
    "license": "MIT",
    "keywords": [
        "spreadsheet",
        "data grid",
        "datagrid",
        "data-grid",
        "grid",
        "table",
        "excel",
        "csv",
        "accessibility",
        "aria",
        "typescript",
        "javascript spreadsheet"
    ],
    "peerDependencies": {
        "@jspreadsheet/formula": "^2.0.2"
    },
    "peerDependenciesMeta": {
        "@jspreadsheet/formula": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jspreadsheet/formula": "^2.0.2",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "c8": "^12.0.0",
        "chai": "^6.3.0",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.5",
        "esbuild-loader": "^4.5.0",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "mocha": "^12.0.3",
        "prettier": "3.10.1",
        "style-loader": "^4.0.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0",
        "webpack": "^5.113.0",
        "webpack-cli": "^7.3.1",
        "webpack-dev-server": "^6.1.0"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "resources/lang"
    ],
    "version": "5.0.4",
    "bugs": "https://github.com/BitBindle/jspreadsheet-ce/issues",
    "homepage": "https://github.com/BitBindle/jspreadsheet-ce#readme",
    "scripts": {
        "format": "npm run prettier:fix && npm run lint:fix",
        "lint": "eslint . && node check-cycles.cjs",
        "lint:fix": "eslint --fix .",
        "prettier": "prettier --check .",
        "prettier:fix": "prettier --write . --ignore-path .prettierignore",
        "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
        "start": "webpack serve --history-api-fallback",
        "build": "webpack --mode production",
        "prepublishOnly": "npm run build",
        "test": "npm run build && mocha \"test/*.ts\"",
        "build:coverage": "webpack --mode production --env coverage",
        "coverage": "npm run build:coverage && c8 mocha \"test/*.ts\""
    }
}
